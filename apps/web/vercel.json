{
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in claude/*) echo 'Skipping Preview build for automated claude/* branch'; exit 0 ;; *) exit 1 ;; esac",
  "crons": [
    {
      "path": "/api/cron/grant-monthly-leaderboard-badges",
      "schedule": "0 1 1 * *"
    },
    {
      "path": "/api/cron/reap-post-images",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/like-coin-grants",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/reap-old-feed-items",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/purge-deleted-accounts",
      "schedule": "0 6 * * *"
    }
  ]
}
