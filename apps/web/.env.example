# Site URL (origin only, no trailing slash)
# e.g. https://www.example.com  (NOT https://www.example.com/)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics (Optional)
# Get your Measurement ID from https://analytics.google.com/
# Format: G-XXXXXXXXXX
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sentry Error Tracking (Optional)
# Get your DSN from https://sentry.io/ -> Settings -> Projects -> Client Keys
# NEXT_PUBLIC_SENTRY_DSN=

# For uploading source maps (Optional - improves error stack traces)
# Get from https://sentry.io/ -> Settings -> Auth Tokens
# SENTRY_AUTH_TOKEN=

# Only needed if uploading source maps (can be found in Sentry project settings)
# SENTRY_ORG=
# SENTRY_PROJECT=


# Contact Form Email Settings (Required for contact form)
# Get your API key from https://resend.com/
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=noreply@yourdomain.com
# CONTACT_TO_EMAIL=contact@yourdomain.com

# === Supabase ===
# Local development: Run `cd apps/web && supabase start` to launch local Supabase.
# Then run `supabase status -o json` to retrieve keys (PUBLISHABLE_KEY, SECRET_KEY, API_URL).
#
# Production: Get these from your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === Database ===
# Local development: Supabase local runs PostgreSQL on port 54322
# Vercel Marketplace: POSTGRES_URL is automatically set by Supabase integration
# Manual setup: Use DATABASE_URL with your connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Stripe (Subscription billing)
# See docs/stripe-setup.md for how to obtain these values
STRIPE_SECRET_KEY=sk_test_...           # Stripe Dashboard > Developers > API keys > Secret key
STRIPE_WEBHOOK_SECRET=whsec_...         # Local: `stripe listen` output / Prod: Dashboard > Webhooks > Signing secret
STRIPE_PRICE_ID=price_...              # Stripe Dashboard > Products > Ad-Free Plan > Price ID

# Google AdSense
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=                       # Include "ca-pub-" prefix (e.g., ca-pub-1234567890123456)
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT_MIDDLE=
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_INFEED_DESKTOP=
NEXT_PUBLIC_ADSENSE_INFEED_LAYOUT_KEY_DESKTOP=
NEXT_PUBLIC_ADSENSE_SLOT_INFEED_MOBILE=
NEXT_PUBLIC_ADSENSE_INFEED_LAYOUT_KEY_MOBILE=
