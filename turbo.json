{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["NODE_ENV", "NEXT_RUNTIME", "SENTRY_ENABLE_DEV"],
  "globalEnv": [
    "DATABASE_URL",
    "RESEND_API_KEY",
    "CRON_SECRET",
    "STRIPE_SECRET_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "POSTGRES_URL_NON_POOLING",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "SENTRY_AUTH_TOKEN",
    "CONTACT_FROM_EMAIL",
    "CONTACT_TO_EMAIL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["POSTGRES_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "test:ui": {
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "cache": false
    },
    "copy-stockfish": {
      "outputs": ["public/stockfish/**"]
    }
  }
}
