{
  "name": "blindfold-chess-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "prepare": "husky"
  },
  "pnpm": {
    "overrides": {
      "browserslist": ">=4.28.1",
      "tar": ">=7.5.7",
      "webpack": "5.105.3",
      "minimatch": ">=3.1.4",
      "serialize-javascript": ">=7.0.3",
      "esbuild": ">=0.25.0"
    },
    "patchedDependencies": {
      "next-navigation-guard@0.2.0": "patches/next-navigation-guard@0.2.0.patch"
    }
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.6"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "volta": {
    "node": "24.12.0"
  }
}
