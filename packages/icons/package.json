      "optional": true
    }
  },
  "dependencies": {
    "@blindfold-chess/types": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "eslint": "^9.39.4",
    "react": "^19.2.5",
    "react-native": "~0.81.5",
    "react-native-svg": "^15.15.4",
    "typescript": "^5.9.3"
  }
